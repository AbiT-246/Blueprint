generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DesignStyle {
  INDIE
  COTTAGECORE
  SOFT_GIRL
  GRUNGE
  WITCHCORE
  E_GIRL
  GALAXY
  ART_HOE
  ANIME
  BOHO
  KAWAII
  DARK_ACADEMIA
  VINTAGE
  DORM
}

enum RoomStatus {
  UPLOADED
  GENERATING
  READY
  FAILED
}

enum ItemCategory {
  FURNITURE
  LIGHTING
  WALL_DECOR
  FLOOR_AND_TEXTILES
  PLANTS_AND_NATURE
  DECORATIVE_OBJECTS
  ELECTRONICS
  STORAGE_AND_ORGANIZATION
  OTHER
}

/// Which surface an item attaches to in the 3D room editor.
enum ItemPlacement {
  FLOOR
  WALL
  CEILING
}

enum Retailer {
  WAYFAIR
  IKEA
  AMAZON
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rooms Room[]
}

/// A user's room project: uploaded photo → AI redesign → editable canvas.
model Room {
  id                String       @id @default(cuid())
  userId            String
  templateId        String?
  title             String?
  style             DesignStyle?
  status            RoomStatus   @default(UPLOADED)
  /// Original empty-room photo uploaded by the user.
  sourceImageUrl    String
  /// AI-generated redesigned room image used as the interactive canvas background.
  generatedImageUrl String?
  /// Optional physical constraints for smarter placement (meters).
  widthMeters       Float?
  depthMeters       Float?
  failureReason     String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  template  Template?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  roomItems RoomItem[]

  @@index([userId])
  @@index([templateId])
  @@index([status])
}

model Template {
  id              String      @id @default(cuid())
  description     String?
  style           DesignStyle @unique
  previewImageUrl String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  rooms         Room[]
  templateItems TemplateItem[]
}

model Item {
  id           String        @id @default(cuid())
  title        String
  /// 2D thumbnail shown in item pickers.
  imageUrl     String
  /// glTF binary (.glb) rendered in the 3D room editor.
  modelUrl     String        @unique
  category     ItemCategory
  placement    ItemPlacement @default(FLOOR)
  /// Real-world bounding box; models are scaled to these dimensions when placed.
  widthMeters  Float
  depthMeters  Float
  heightMeters Float
  description  String?
  embeddingId  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  roomItems     RoomItem[]
  templateItems TemplateItem[]
  productOffers ProductOffer[]

  @@index([category])
  @@index([title])
}

/// Position is the item's base center in room space (meters, Y up, camera looking down -Z).
model RoomItem {
  id        String   @id @default(cuid())
  roomId    String
  itemId    String
  positionX Float
  positionY Float    @default(0)
  positionZ Float
  scale     Float    @default(1)
  /// Degrees around the vertical (Y) axis.
  rotation  Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([roomId])
  @@index([itemId])
}

/// Position is the item's base center in room space (meters, Y up, camera looking down -Z).
model TemplateItem {
  id         String   @id @default(cuid())
  templateId String
  itemId     String
  positionX  Float
  positionY  Float    @default(0)
  positionZ  Float
  scale      Float    @default(1)
  /// Degrees around the vertical (Y) axis.
  rotation   Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  item     Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([templateId, itemId])
  @@index([templateId])
  @@index([itemId])
}

model ProductOffer {
  id         String   @id @default(cuid())
  itemId     String
  retailer   Retailer
  title      String
  priceCents Int
  currency   String   @default("USD")
  productUrl String
  imageUrl   String?
  externalId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, retailer, productUrl])
  @@index([itemId])
  @@index([retailer])
}
