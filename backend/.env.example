PORT=3001
CORS_ORIGIN=http://localhost:3000
# Use localhost + POSTGRES_PORT when running Nest on the host.
# Inside Docker Compose, DATABASE_URL is injected as postgres:5432 automatically.
DATABASE_URL=postgresql://blueprint:blueprint@localhost:5432/blueprint

# Required. Same value as root API_KEY.
API_KEY=

# IKEA unofficial APIs (no credentials required)
IKEA_COUNTRY=ca
IKEA_LANGUAGE=en

# OpenAI
OPENAI_API_KEY=

# Meshy Image-to-3D API
MESHY_API_KEY=
