PORT=3001
CORS_ORIGIN=http://localhost:3000
# Use localhost + POSTGRES_PORT when running Nest on the host.
# Inside Docker Compose, DATABASE_URL is injected as postgres:5432 automatically.
DATABASE_URL=postgresql://blueprint:blueprint@localhost:5432/blueprint

# eBay Browse API (application keys from developer.ebay.com)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Optional: production (default) | sandbox
EBAY_ENV=production
# Optional marketplace header; defaults to EBAY_US
EBAY_MARKETPLACE_ID=EBAY_US
