# Postgres (Docker Compose)
POSTGRES_USER=blueprint
POSTGRES_PASSWORD=blueprint
POSTGRES_DB=blueprint
POSTGRES_PORT=5432

# App ports (host)
FRONTEND_PORT=3000
BACKEND_PORT=3001

# Browser-facing URLs (host machine)
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# OpenAI
OPENAI_API_KEY=

# eBay Browse API (application keys from developer.ebay.com)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Optional: production (default) | sandbox
EBAY_ENV=production
# Optional marketplace header; defaults to EBAY_US
EBAY_MARKETPLACE_ID=EBAY_US

