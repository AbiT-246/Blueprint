# Postgres (Docker Compose)
POSTGRES_USER=blueprint
POSTGRES_PASSWORD=blueprint
POSTGRES_DB=blueprint
POSTGRES_PORT=5432

# App ports (host)
FRONTEND_PORT=3000
BACKEND_PORT=3001

# Browser-facing URLs (host machine)
CORS_ORIGIN=http://localhost:3000

# Backend origin used by the Next.js server-side API proxy
BACKEND_URL=http://localhost:3001

# Shared API key (required). Frontend proxy injects this; do not prefix with NEXT_PUBLIC_
API_KEY=

# OpenAI
OPENAI_API_KEY=

# IKEA unofficial APIs (no credentials required)
IKEA_COUNTRY=ca
IKEA_LANGUAGE=en

# Meshy Image-to-3D API
MESHY_API_KEY=

# Run prisma db seed when the backend container starts
SEED_DATABASE=true
